{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-swarm/web/snapshot-schema.json",
  "title": "orch_status read-route snapshot",
  "description": "The request fields the orch_status wire accepts (crates/gsd-route orch_status_wire.rs). The loader rejects any other key, a missing required key, or a value nested deeper than 32 (the root is depth 0).",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "agent", "script", "correlation", "db_path", "swarm_dir", "events", "tasks", "verdicts"],
  "properties": {
    "mode": { "enum": ["list", "history"] },
    "agent": { "type": "string" },
    "script": { "const": "orch_status" },
    "correlation": { "type": ["string", "null"] },
    "db_path": { "type": "string" },
    "swarm_dir": { "type": "string" },
    "events": { "type": "integer", "minimum": 0 },
    "tasks": { "type": "array" },
    "verdicts": { "type": "array" },
    "history": {
      "type": "object",
      "required": ["task_id", "task", "transitions"],
      "properties": {
        "task_id": { "type": "string" },
        "task": { "type": ["object", "null"] },
        "transitions": { "type": "array" }
      }
    }
  },
  "x-max-depth": 32
}
